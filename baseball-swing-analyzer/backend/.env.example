# Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used to write coaching feedback
CLAUDE_MODEL=claude-opus-5-5

# Where uploaded videos and analysis results are stored (relative to backend/)
STORAGE_DIR=storage

# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=200

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# MediaPipe pose model. Downloaded from POSE_MODEL_URL on first analysis if the
# file doesn't exist yet.
POSE_MODEL_PATH=storage/models/pose_landmarker_full.task
# POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/latest/pose_landmarker_full.task

# Frames beyond this are skipped (keeps long clips from tying up the server)
MAX_ANALYSIS_FRAMES=900
